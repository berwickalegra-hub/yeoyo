generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  // Nullable: OAuth-only users (e.g. signed up with Google) never set a
  // password. Email/password signup still requires it; the auth route
  // enforces presence at runtime.
  passwordHash           String?
  emailVerifiedAt        DateTime?
  tokenVersion           Int       @default(0)
  withdrawalPinHash      String? // bcrypt hash of withdrawal PIN; null = no PIN set
  // Optional display name — populated from OAuth profile on first sign-in.
  // Email/password users can fill it later via /api/auth/me PATCH (future).
  name                   String?
  // Optional avatar URL — populated from OAuth profile on first sign-in.
  avatarUrl              String?
  // App-wide role. USER is the default; MODERATOR unlocks a scoped subset
  // of /admin (verification queue, reports, support); ADMIN unlocks the
  // full back-office; SUPERADMIN can promote/demote other admins and
  // manage 2FA/invites. Bootstrap an initial SUPERADMIN via
  // `pnpm db:make-superadmin <email>` (see scripts).
  role                   String    @default("USER") // USER | MODERATOR | ADMIN | SUPERADMIN | AFFILIATE
  // Account status. ACTIVE = login + refresh allowed; SUSPENDED = both
  // refused with 403 ACCOUNT_SUSPENDED. Mutated via /api/admin/users/[id]/status
  // (ADMIN can suspend; only SUPERADMIN can restore).
  status                 String    @default("ACTIVE") // ACTIVE | SUSPENDED
  // TOTP 2FA — SUPERADMIN only, opt-in. Secret is AES-256-GCM encrypted at
  // rest (see lib/server/admin/two-factor.ts) using ENCRYPTION_KEY, never
  // stored or logged in plaintext. Recovery codes are bcrypt hashes, each
  // consumable once (removed from the array on use).
  twoFactorSecret        String?
  twoFactorEnabled       Boolean   @default(false)
  twoFactorRecoveryCodes Json?
  // Pay-per-use credit balance (2026-08-25 replacement for the old
  // recurring Premium subscription) — never negative, only ever mutated
  // through lib/server/credits/ledger.ts's atomic CAS helpers. Credits
  // don't expire.
  creditBalance          Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  verificationCodes       VerificationCode[]
  uploads                 FileUpload[]
  notifications           Notification[]
  notifPrefs              NotificationPreferences?
  orders                  Order[]
  withdrawals             Withdrawal[]
  oauthAccounts           OAuthAccount[]
  adminActions            AdminAction[]
  invitesSent             AdminInvite[]
  twoFactorChallenges     AdminTwoFactorChallenge[]
  profile                 Profile?
  likesGiven              Like[]                    @relation("LikesGiven")
  likesReceived           Like[]                    @relation("LikesReceived")
  contactRequestsSent     ContactRequest[]          @relation("ContactRequestsSent")
  contactRequestsReceived ContactRequest[]          @relation("ContactRequestsReceived")
  conversationsAsUserA    Conversation[]            @relation("ConversationsAsUserA")
  conversationsAsUserB    Conversation[]            @relation("ConversationsAsUserB")
  messagesSent            Message[]                 @relation("MessagesSent")
  blocksGiven             BlockedUser[]             @relation("BlocksGiven")
  blocksReceived          BlockedUser[]             @relation("BlocksReceived")
  creditTransactions      CreditTransaction[]
  reportsFiled            Report[]                  @relation("ReportsFiled")
  reportsReceived         Report[]                  @relation("ReportsReceived")
  coachMessages           CoachMessage[]
  supportThread           SupportMessage[]          @relation("SupportMessagesForUser")
  supportMessagesSent     SupportMessage[]          @relation("SupportMessagesSent")
  profileViewsGiven       ProfileView[]             @relation("ProfileViewsGiven")
  profileViewsReceived    ProfileView[]             @relation("ProfileViewsReceived")
  favoritesGiven          Favorite[]                @relation("FavoritesGiven")
  favoritesReceived       Favorite[]                @relation("FavoritesReceived")
  pushSubscriptions       PushSubscription[]

  // Multi-tenancy is opt-in per project: by default no resource is org-scoped.
  // Apps that need it (marketplace, B2B SaaS, classifieds) wire owner relations
  // on their domain models.
  ownedOrganizations Organization[]       @relation("OrgOwner")
  memberships        OrganizationMember[] @relation("OrgMembership")

  // Affiliate program — a User with role="AFFILIATE" is a separate account
  // type (never a dating-app user in parallel), created only via
  // POST /api/admin/affiliates (SUPERADMIN-only, reuses the AdminInvite
  // flow). affiliateCode is generated once at account creation and never
  // regenerated (an already-shared referral link must stay valid).
  affiliateCode String? @unique

  // Filleul → parrain. Set exactly once, at signup (POST /api/auth/signup),
  // never modified afterward — permanent attribution. onDelete: SetNull so
  // a (hypothetical, not built in V1) affiliate-account deletion never
  // cascades into deleting the referred user.
  referredByAffiliateId String?
  referredByAffiliate   User?   @relation("AffiliateReferrals", fields: [referredByAffiliateId], references: [id], onDelete: SetNull)
  referredUsers         User[]  @relation("AffiliateReferrals")

  affiliateEarnings AffiliateEarning[] @relation("AffiliateEarnings")
  earningsGenerated AffiliateEarning[] @relation("ReferredUserEarnings")

  // Peer-to-peer referral program (2026-08-31) — every regular user can
  // refer other regular users through the same affiliateCode/promoCode
  // mechanism as the AFFILIATE cash program above, but earns points
  // instead of FCFA. Incremented by ReferralBonus rows (10 points per
  // verified referral) and drained automatically into
  // CreditTransaction(type=REFERRAL_CONVERSION) every time it crosses a
  // 100-point threshold. See POST /api/admin/verification-queue/[id]/process
  // and lib/server/referrals/points.ts for the constants.
  referralPoints Int @default(0)

  referralBonusesGiven    ReferralBonus[] @relation("ReferralBonusesGiven")
  referralBonusesReceived ReferralBonus[] @relation("ReferralBonusesReceived")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([affiliateCode])
  @@index([referredByAffiliateId])
}

// ───────────────────────────────────────────────────────────────────────
// Admin audit log — every back-office mutation is recorded here so we can
// answer "who did what when" during incidents / compliance reviews.
//
// `action` is a free-form dotted string the UI groups by (e.g.
// "withdrawal.cancel", "user.role_change", "order.refund").
// `targetType` + `targetId` reference the affected row when applicable.
// `metadata` carries the diff or extra context as JSON.
//
// Retention: not pruned automatically (compliance). If your jurisdiction
// requires deletion after N years, add a cron in backend/src/index.ts
// modeled on the WebhookLog purge.
// ───────────────────────────────────────────────────────────────────────
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ───────────────────────────────────────────────────────────────────────
// Admin invitations — SUPERADMIN invites a new MODERATOR/ADMIN/SUPERADMIN
// by email. `tokenHash` is a SHA-256 hex digest of the raw token mailed to
// the invitee (the raw token is never stored — same threat model as a
// password, since possessing it grants an admin role on acceptance).
// ───────────────────────────────────────────────────────────────────────
model AdminInvite {
  id          String    @id @default(cuid())
  email       String
  // Optional display name — only ever set by POST /api/admin/affiliates
  // (affiliate invites carry a name; MODERATOR/ADMIN/SUPERADMIN invites
  // from POST /api/admin/invites never set this, stays null for them).
  name        String?
  role        String // MODERATOR | ADMIN | SUPERADMIN | AFFILIATE
  tokenHash   String    @unique
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Restrict)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([tokenHash])
}

// ───────────────────────────────────────────────────────────────────────
// Affiliate program — one row per real, confirmed earning event. Never
// updated after creation except `paidAt` (set in bulk by
// POST /api/admin/affiliates/[id]/mark-paid). A gain is only ever
// inserted at the exact moment the underlying event is confirmed in the
// database (profile actually flips to VERIFIED; Order actually flips to
// PAID) — never speculatively, never reversed.
// ───────────────────────────────────────────────────────────────────────
// WARNING: this table has TWO hand-written Postgres PARTIAL unique indexes
// that Prisma cannot represent in this schema file:
//   - AffiliateEarning_one_verification_bonus_per_user (migration
//     20260826073426_affiliate_program)
//   - AffiliateEarning_one_first_match_bonus_per_user (migration
//     20260827_first_match_bonus_index)
// If `prisma migrate dev` ever generates a migration containing a
// `DROP INDEX` for either of these, DO NOT apply it as-is — they are the
// DB-level guarantees against a duplicate VERIFICATION_BONUS or
// FIRST_MATCH_BONUS row per referredUserId. Edit the generated migration to
// remove those DROP statements before applying.
model AffiliateEarning {
  id             String    @id @default(cuid())
  affiliateId    String
  affiliate      User      @relation("AffiliateEarnings", fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUserId String
  referredUser   User      @relation("ReferredUserEarnings", fields: [referredUserId], references: [id], onDelete: Cascade)
  type           String // VERIFICATION_BONUS | CREDIT_COMMISSION | FIRST_MATCH_BONUS
  amount         Int // FCFA, always positive
  // Set only for type=CREDIT_COMMISSION — informative reference to the
  // Order that triggered it, same non-strict-FK convention as
  // CreditTransaction.relatedOrderId (must never fail this insert).
  relatedOrderId String?
  // null = awaiting payout; timestamp = paid (see mark-paid route).
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([affiliateId, paidAt])
  @@index([referredUserId, type])
}

// One row per successfully rewarded peer-to-peer referral (2026-08-31).
// referredUserId is unique — a given referred account can trigger this
// bonus at most once, ever, enforced at the database level (a full unique
// constraint, not a partial index like AffiliateEarning's, since this
// table only ever holds this one kind of row). Also the source of truth
// for the monthly cap: count rows for a referrer created since the start
// of the current calendar month. Rows are inserted by
// POST /api/admin/verification-queue/[id]/process; point/cap constants
// live in lib/server/referrals/points.ts.
model ReferralBonus {
  id             String   @id @default(cuid())
  referrerId     String
  referrer       User     @relation("ReferralBonusesGiven", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId String   @unique
  referredUser   User     @relation("ReferralBonusesReceived", fields: [referredUserId], references: [id], onDelete: Cascade)
  points         Int
  createdAt      DateTime @default(now())

  @@index([referrerId, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Bridges password-verified → TOTP-verified during SUPERADMIN login. A row
// exists only while the second factor is pending; `consumedAt` is set (not
// deleted) on successful verify, or the row is left to expire (short TTL)
// otherwise. No cleanup cron yet — see the admin-backoffice-auth-foundation
// SDD ledger's deferred-minor list.
// ───────────────────────────────────────────────────────────────────────
model AdminTwoFactorChallenge {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// Multi-tenancy primitives — opt-in.
//
// Default project surface stays user-owned (`Order.userId`, `Withdrawal.userId`).
// Apps that need orgs add `organizationId String?` to their domain models
// case by case and use `requireOrgRole()` middleware to gate access.
//
// Slug must be unique app-wide (not just within an owner) so it can be
// used as a stable URL segment.
// ───────────────────────────────────────────────────────────────────────
model Organization {
  id        String               @id @default(cuid())
  slug      String               @unique
  name      String
  ownerId   String
  owner     User                 @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   OrganizationMember[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([ownerId])
}

// Role precedence: OWNER > ADMIN > MEMBER. The owner is also a member row
// (created in the same tx as the org) so list-my-orgs queries can join
// uniformly via memberships.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("OrgMembership", fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// OAuth identities — one User can have N linked providers (Google, GitHub, …).
// (provider, providerAccountId) is unique so the same Google account can't
// link twice. Email matching at sign-in is intentional: if a user signed up
// with email/password and later "Sign in with Google" using the same email,
// we link the Google account to the existing user instead of creating a
// duplicate (see backend/src/routes/oauth.ts).
// ───────────────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "github" | …
  providerAccountId String // sub from the OIDC ID token
  // Optional refresh token (encrypted at rest if you store one) — Google
  // only returns it on first consent with `access_type=offline`. Most
  // boilerplate flows don't need it; we keep the column for future use.
  refreshToken      String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([code, type])
}

// ───────────────────────────────────────────────────────────────────────
// File uploads — Cloudinary (column names kept from the R2 era; no migration needed)
// ───────────────────────────────────────────────────────────────────────
model FileUpload {
  id                  String          @id @default(cuid())
  userId              String? // nullable — uploads can be anonymous if route allows
  user                User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  key                 String          @unique // Cloudinary public_id (column name historical — was R2 object key)
  filename            String
  mimeType            String
  sizeBytes           Int
  createdAt           DateTime        @default(now())
  profilePhoto        ProfilePhoto?
  messageImage        Message?
  supportMessageImage SupportMessage?

  @@index([userId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// YeOyo domain — dating-app profile (1:1 with User).
//
// `gender` / `religion` / `maritalStatus` / `childrenCount` / `intent` follow
// this kit's convention of a plain String with an inline comment listing
// valid values, rather than a native Prisma enum (see User.role for the
// precedent) — keeps adding a new option a data change, not a migration.
//
// Note: the Banani onboarding designs disagree on name capture — the mobile
// single-step screen asks for "Nom complet" (full name), the desktop 4-step
// flow asks only "Prénom" (first name). Modeled as firstName + optional
// lastName so either UI can populate it; reconcile the actual form copy
// when Phase B builds the onboarding screens.
// ───────────────────────────────────────────────────────────────────────
model Profile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender                String // HOMME | FEMME
  firstName             String
  lastName              String?
  dateOfBirth           DateTime
  // ISO2, one of the 6 payment-supported countries (see
  // lib/yeoyo/constants.ts's COUNTRIES — kept in sync with Chariow's
  // configured checkout countries on purpose, never edit one list without
  // the other). Nullable: existing profiles predate this field. Drives the
  // Explorer same-country default filter and the credits shop's local-price
  // estimate.
  country               String?
  city                  String    @default("Kinshasa")
  commune               String? // Kinshasa neighborhood, e.g. "Gombe"
  religion              String? // CHRETIEN | CATHOLIQUE | PROTESTANT | MUSULMAN
  maritalStatus         String? // CELIBATAIRE | DIVORCE | VEUF_VEUVE
  childrenCount         String? // "0" | "1" | "2" | "3+"
  // "Projet de vie" fields — optional, filled after onboarding (Paramètres),
  // per explicit product decision not to lengthen the signup wizard further.
  wantsChildren         String? // OUI | NON | PEUT_ETRE
  relocateOpen          String? // OUI | NON | A_DISCUTER
  qualities             String? // free text — "Mes qualités"
  flaws                 String? // free text — "Mes défauts"
  dealbreakers          String? // free text — "Ce que je n'accepte pas"
  // Who shows up in Découvrir/Explorer for this user. Null = default to the
  // opposite of `gender` (binary onboarding model, unchanged default
  // behavior). "TOUS" opts into seeing both genders — set at onboarding or
  // in Paramètres. Explorer's own gender chip filter can still override this
  // per-search; this only changes what loads with no override applied.
  interestedIn          String? // HOMME | FEMME | TOUS
  intent                String // COURT_TERME | MOYEN_TERME | LONG_TERME
  job                   String?
  bio                   String?
  interests             String[]  @default([])
  languages             String[]  @default([])
  visibilityPublic      Boolean   @default(true)
  onlineStatusVisible   Boolean   @default(true)
  // Illustration/demo profile (the pre-launch seed batches — see
  // scripts/seed-yeoyo-*.ts). Real users NEVER see a demo profile in
  // discovery or on a profile page, regardless of country; only other
  // demo accounts do, so the seed set can still be filmed for promo
  // material. Set in bulk by scripts/park-demo-profiles.ts (2026-08-31,
  // explicit pre-launch ask). Nothing sets this true at runtime.
  demo                  Boolean   @default(false)
  // Flexible discovery filters — { ageMin, ageMax, commune, intent: [...] }.
  // JSON like NotificationPreferences.prefs, to avoid a migration per new filter.
  searchPrefs           Json?
  // Identity verification (2026-08-31 — self-service flow added, see
  // /app/verification + /api/profile/verification). Lifecycle:
  //   UNVERIFIED  default — nothing submitted
  //   PENDING     the user uploaded a code-in-hand selfie, awaiting an admin
  //   VERIFIED    admin approved — sets verifiedAt, drives the public badge
  //               (profile/card.ts's `verified: !!p.verifiedAt`)
  //   REJECTED    admin refused — verificationRejectionReason holds why; the
  //               user can redo (a new code is issued, status → PENDING)
  // The admin queue is `verificationStatus = 'PENDING'` — genuinely-submitted
  // profiles only, oldest verificationSubmittedAt first.
  verifiedAt                  DateTime?
  verificationStatus          String    @default("UNVERIFIED")
  // Cloudinary key of the code-in-hand selfie the user submitted. Cleared
  // once the admin resolves the request (approve or reject).
  verificationSelfieKey       String?
  // Short code (e.g. "YO-4821") we ask the user to write on paper and hold
  // in the selfie — proves the photo is fresh and really them. Regenerated
  // on each new attempt; cleared once resolved.
  verificationCode            String?
  verificationSubmittedAt     DateTime?
  // Admin's free-text note on the last REJECT — shown to the user so they
  // know what to fix before resubmitting.
  verificationRejectionReason String?
  onboardingCompletedAt DateTime?
  // Set by POST /api/profile/boost. While in the future, the profile sorts
  // first in /api/profiles/explorer (tie-break only — gender/preference
  // filtering is unaffected). See IMPLEMENTATION-PLAN-v2.md for the
  // cooldown rule (free: 1/24h, Premium: unlimited).
  boostedUntil          DateTime?
  // Persistent per-feature reveal marker (2026-08-25, credit gating Script
  // 3): every Favorite/ProfileView row with `createdAt <= this timestamp`
  // stays revealed forever once unlocked via POST /api/credits/spend; a
  // NEW row created after that (someone new favorites/visits) shows
  // blurred again and needs a fresh 1-credit unlock, which simply bumps
  // this timestamp forward — never loses an earlier reveal. Null = never
  // unlocked (everything blurred).
  favoritedByUnlockedAt DateTime?
  visitorsUnlockedAt    DateTime?
  // Set by POST /api/subscriptions/checkout on first successful submit —
  // reused to pre-fill the phone step on future Premium checkouts. Chariow
  // requires { national number, ISO2 country } per checkout, not stored
  // anywhere else on the user.
  phone                 String?
  phoneCountry          String? // ISO2, e.g. "CD", "SN" — paired with `phone`
  // "Message" shortcut on Découvrir's swipe card (POST /api/likes + jump
  // straight into the conversation, before the request is formally
  // accepted) — free for FREE_FLASH_MESSAGE_LIMIT uses per rolling 24h
  // window (see flashMessagesResetAt below), then gated behind Premium via
  // PremiumGateModal. Distinct from the existing daily sent-message cap in
  // lib/server/conversations/message-quota.ts, which limits messages sent
  // *inside* an already-open conversation — this counts uses of the
  // shortcut itself. ACTIVE Premium subscribers never consume this.
  flashMessagesUsed     Int       @default(0)
  // End of the current free-quota window (now + 24h, set on first use of a
  // fresh window). Once now() passes this timestamp, the next attempt
  // resets flashMessagesUsed back to 0 and opens a new window — see
  // lib/server/conversations/flash-message-quota.ts.
  flashMessagesResetAt  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  photos ProfilePhoto[]

  @@index([userId])
  @@index([verifiedAt])
  @@index([verificationStatus])
  @@index([gender, city])
  @@index([gender, country])
  @@index([boostedUntil])
}

model ProfilePhoto {
  id           String     @id @default(cuid())
  profileId    String
  profile      Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fileUploadId String     @unique
  fileUpload   FileUpload @relation(fields: [fileUploadId], references: [id], onDelete: Cascade)
  isPrimary    Boolean    @default(false)
  order        Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([profileId])
}

// ───────────────────────────────────────────────────────────────────────
// YeOyo domain — discovery loop. Liking a profile auto-creates a PENDING
// ContactRequest (per the Demandes screen's own explainer: "Tu likes un
// profil → Une demande de contact est envoyée automatiquement") — see
// POST /api/likes, which writes both rows in one transaction.
// ───────────────────────────────────────────────────────────────────────
model Like {
  id        String   @id @default(cuid())
  likerId   String
  liker     User     @relation("LikesGiven", fields: [likerId], references: [id], onDelete: Cascade)
  likedId   String
  liked     User     @relation("LikesReceived", fields: [likedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([likerId, likedId])
  @@index([likedId])
}

// A bookmark, distinct from Like — Favorite has no side effect (no auto
// ContactRequest), it's just a personal shortlist. Banani's "Favoris" TopNav
// tab / Découvrir star button. Unrelated to the existing /app/likes page
// ("Mes likes" = who liked me, i.e. received Like rows).
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("FavoritesGiven", fields: [userId], references: [id], onDelete: Cascade)
  targetId  String
  target    User     @relation("FavoritesReceived", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, targetId])
  @@index([targetId])
}

// One row per profile view. Powers the "Visiteurs" screen (who viewed my
// profile). Written best-effort by GET /api/profiles/[userId] — a viewer
// looking at their own profile never records a self-view.
model ProfileView {
  id        String   @id @default(cuid())
  viewerId  String
  viewer    User     @relation("ProfileViewsGiven", fields: [viewerId], references: [id], onDelete: Cascade)
  viewedId  String
  viewed    User     @relation("ProfileViewsReceived", fields: [viewedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([viewedId, createdAt])
  @@index([viewerId])
}

model ContactRequest {
  id               String   @id @default(cuid())
  requesterId      String
  requester        User     @relation("ContactRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  targetId         String
  target           User     @relation("ContactRequestsReceived", fields: [targetId], references: [id], onDelete: Cascade)
  status           String   @default("PENDING") // PENDING | VIEWED | ACCEPTED | CANCELLED
  // Message Flash (2026-08-27) — optional personalized message attached at
  // request time, shown to the target before she accepts/declines. Becomes
  // the conversation's real first Message once the request is accepted or
  // auto-accepted via mutual match (see POST /api/likes and POST
  // /api/contact-requests/[id]/respond). Non-refundable if declined — the
  // 3-credit charge already happened at send time in POST /api/likes.
  flashMessageBody String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  conversation Conversation?

  @@unique([requesterId, targetId])
  @@index([targetId, status])
  @@index([requesterId, status])
}

// ───────────────────────────────────────────────────────────────────────
// YeOyo domain — messaging (Phase D). A Conversation is created when a
// ContactRequest is ACCEPTED (see POST /api/contact-requests/[id]/respond),
// or immediately when a new like completes a mutual match (both sides have
// liked each other — see POST /api/likes). userAId/userBId are stored in
// canonical sorted-id order (see lib\server\conversations\lib.ts:orderedPair)
// so the unique constraint holds regardless of which side accepted, and
// lookups don't need an OR clause.
// ───────────────────────────────────────────────────────────────────────
model Conversation {
  id               String         @id @default(cuid())
  userAId          String
  userA            User           @relation("ConversationsAsUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId          String
  userB            User           @relation("ConversationsAsUserB", fields: [userBId], references: [id], onDelete: Cascade)
  contactRequestId String         @unique
  contactRequest   ContactRequest @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)
  lastMessageAt    DateTime?
  createdAt        DateTime       @default(now())
  // Per-side mute (2026-08-14) — suppresses MESSAGE_RECEIVED notifications
  // for whichever side muted; does not affect the other side, does not
  // affect unread counts (muting silences pushes, it doesn't hide the
  // conversation). Two flat booleans, not a join table, since this schema
  // only supports 1:1 conversations (userA/userB) — same pattern already
  // used for that pairing everywhere else in this model.
  mutedByUserA     Boolean        @default(false)
  mutedByUserB     Boolean        @default(false)

  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  // Empty string for an image-only message (no caption) — kept non-nullable
  // so every existing consumer that reads `.body` as a string keeps working.
  body           String       @default("")
  // Optional image attachment (2026-08-10, user-driven — "ajouter une image
  // pour envoyer une image ou juste chater"). One upload per message, same
  // ownership-check pattern as ProfilePhoto/POST /api/profile/photos.
  imageUploadId  String?      @unique
  imageUpload    FileUpload?  @relation(fields: [imageUploadId], references: [id], onDelete: SetNull)
  readAt         DateTime?
  // Soft-delete only (2026-08-14, "unsend") — the row stays for
  // conversation-history integrity (e.g. Conversation.lastMessageAt already
  // points at it, an admin audit trail, etc.); the API redacts `body`/
  // `imageUrl` and returns `deleted: true` once this is set instead of hard
  // deleting. Own messages only, no time limit (see DELETE route).
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// Blocking hides both users from each other's Découverte/Explorer results
// and refuses new messages in either direction (existing conversation rows
// are kept for history/moderation, not deleted).
model BlockedUser {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — durable email queue rows
// ───────────────────────────────────────────────────────────────────────
model EmailJob {
  id          String    @id @default(cuid())
  to          String
  subject     String
  html        String
  text        String?
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — notifications (at-most-once via dedupeKey)
// ───────────────────────────────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreferences {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON map of { eventType: { email: bool, inApp: bool } } — flexible without migrations.
  prefs     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// Outbox — durable side-effects (notifications, emails) emitted from
// inside transactions (e.g. webhook handlers, withdrawal flow). Side-effect
// rows are inserted in the same tx as the state change, then a worker
// drains them. Survives crashes the previous postCommit-callback pattern
// silently dropped.
//
// `kind` is a free-form string the dispatcher routes on
// (e.g. "notification.payment_received", "email.payment_confirmation").
// ───────────────────────────────────────────────────────────────────────
model OutboxEvent {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — webhook idempotency log
// ───────────────────────────────────────────────────────────────────────
model WebhookLog {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([externalId, eventType])
  @@index([provider, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 3 — payments (Order + Withdrawal)
//
// `amount` is stored in the smallest unit of `currency` (no decimals).
// For XOF (FCFA, Senegal) that's 1 = 1 FCFA. For USD adapt to cents
// at the call site — the schema is currency-agnostic.
// ───────────────────────────────────────────────────────────────────────
model Order {
  id            String  @id @default(cuid())
  userId        String? // nullable — guest checkout supported
  user          User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount        Int // gross amount, smallest unit
  currency      String  @default("XOF") // ISO 4217
  status        String  @default("PENDING") // PENDING | PAID | EXPIRED | FAILED | REFUNDED
  customerEmail String?
  customerPhone String?
  customerName  String?
  metadata      Json? // app-specific fields

  // Stripe-grade idempotency. Required header on POST /api/orders; replay
  // with same value returns the original Order row instead of double-charging.
  // Nullable so existing rows pre-migration don't break the @unique constraint.
  idempotencyKey String? @unique

  // Provider reference
  provider         String // e.g. "bictorys"
  providerChargeId String? @unique
  paymentUrl       String? // checkout/redirect URL returned by provider
  paymentMethod    String? // WAVE | ORANGE_MONEY | FREE_MONEY (set on PAID by webhook)

  // Optional commission (for marketplace-style apps)
  commissionAmount Int?
  netAmount        Int?

  // Lifecycle
  expiresAt DateTime // PENDING expiry; not cleared on PAID (history)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([provider, providerChargeId])
}

// ───────────────────────────────────────────────────────────────────────
// YeOyo domain — pay-per-use credits (2026-08-25, replaces the old
// recurring Premium Subscription model). Credit purchases still go
// through Order/Chariow exactly as subscription purchases did — an Order
// reaching PAID is what triggers lib/server/credits/ledger.ts's
// grantCredits() (see lib/server/credits/reconcile.ts). This table is the
// append-only ledger for every balance change (purchase, spend, admin
// grant), so a user's consumption history can be shown verbatim; the fast
// balance check itself lives on User.creditBalance, kept in sync with
// this ledger inside the same transaction as every mutation.
// ───────────────────────────────────────────────────────────────────────
model CreditTransaction {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // PURCHASE | SPEND | ADMIN_GRANT | WELCOME_GIFT | REFERRAL_CONVERSION
  amount         Int // positive for PURCHASE/ADMIN_GRANT, negative for SPEND
  // e.g. "credit_pack:serieux", "view_visitors", "view_favorited_by",
  // "boost", "first_message", "admin_grant" — free-form action label,
  // rendered into a human-readable line on the consumption-history screen.
  action         String
  // Set only for type=PURCHASE — no strict FK to Order (this ledger must
  // never fail to insert because of an Order-side constraint), just a
  // plain reference id for support/debugging.
  relatedOrderId String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model Withdrawal {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount      Int // requested amount, smallest unit
  currency    String @default("XOF")
  status      String @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  destination Json // { method: "WAVE" | "ORANGE_MONEY" | ..., phone: "+221...", accountName?: "..." }

  // Provider reference
  provider         String // e.g. "bictorys"
  providerPayoutId String? @unique
  failureReason    String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  completedAt DateTime?

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@index([provider, providerPayoutId])
}

// ───────────────────────────────────────────────────────────────────────
// YeOyo domain — Signalements (Phase F). No Banani screen actually exposes
// a "Signaler" trigger (only the Admin Panel's review side was designed),
// but a moderation queue with nothing feeding it is dead UI — added a
// minimal report action alongside the existing "Bloquer" button in the
// Messages thread (both are user-safety actions, natural pairing) so
// POST /api/reports has a real caller.
// ───────────────────────────────────────────────────────────────────────
model Report {
  id         String    @id @default(cuid())
  reporterId String
  reporter   User      @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetId   String
  target     User      @relation("ReportsReceived", fields: [targetId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  status     String    @default("PENDING") // PENDING | RESOLVED | DISMISSED
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
  @@index([targetId])
}

// ───────────────────────────────────────────────────────────────────────
// YeOyo domain — "Coach" AI chat (2026-08-10, user-driven, inspired by a
// competitor app's floating coach widget). One flat, ever-growing thread
// per user (no separate "conversation" wrapper — simpler than the peer
// Conversation model since there's exactly one coach, not N counterparts).
// Free tier: 3 USER-role messages per UTC calendar day (counted via a
// `createdAt` range query on this table — no separate counter row, so
// there's nothing to keep in sync); ACTIVE subscribers are unlimited. See
// lib/server/coach/ for the quota check and the (optional, inert without
// ANTHROPIC_API_KEY) Anthropic-backed reply generator.
// ───────────────────────────────────────────────────────────────────────
model CoachMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // USER | ASSISTANT
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Support inbox (2026-08-29, explicit user ask — replaces the floating
// Coach AI button with a human "contact support" one). Same flat,
// ever-growing-thread-per-user shape as CoachMessage above (one thread per
// end user, no separate ticket/status wrapper — an admin's own reply is
// itself the signal the thread was seen) — deliberately NOT a full
// Conversation-style two-relation model since there's exactly one support
// inbox, not N counterparts per user.
//
// `userId` is the thread owner (always the end user, never an admin).
// `senderId` is whoever actually typed this row — the end user for
// senderRole=USER, or the responding admin's own id for senderRole=ADMIN —
// kept separate from `userId` so "who replied" survives even though the
// thread itself is always keyed by the end user. Mirrors Message.senderId's
// role in the peer-to-peer Conversation model.
//
// `readByAdminAt`: null on every USER-authored row until an admin opens the
// thread (GET /api/admin/support/[userId] bulk-marks them), same
// null-until-seen convention as Message.readAt. ADMIN-authored rows never
// set this — it only tracks whether admin has seen the user's own messages.
// Un-actioned USER rows (readByAdminAt IS NULL) is exactly the "unread"
// count driving the AdminSidebar badge.
//
// Image attachment: identical FileUpload relation as Message.imageUploadId
// above (screenshot of a bug, same POST /api/upload flow every other
// attachment in this app already uses).
model SupportMessage {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation("SupportMessagesForUser", fields: [userId], references: [id], onDelete: Cascade)
  senderRole    String // USER | ADMIN
  senderId      String
  sender        User        @relation("SupportMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  content       String      @default("")
  imageUploadId String?     @unique
  imageUpload   FileUpload? @relation(fields: [imageUploadId], references: [id], onDelete: SetNull)
  readByAdminAt DateTime?
  createdAt     DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([senderRole, readByAdminAt])
}

// ───────────────────────────────────────────────────────────────────────
// Web Push Notifications — subscription metadata for each registered device.
// One row per unique ServiceWorker registration (unique endpoint per device).
// ───────────────────────────────────────────────────────────────────────
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}
