{
  "name": "frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000 --turbopack",
    "dev:webpack": "next dev --port 3000 --webpack",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:integration": "echo 'Phase 1: deferred to Phase 4 — see CONTEXT.md D-26' && exit 0",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:make-superadmin": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/make-superadmin.ts",
    "dev:verification-code": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/get-verification-code.ts",
    "db:backfill-legacy-country": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/backfill-legacy-country.ts",
    "db:cleanup-legacy-conversations": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/cleanup-legacy-empty-conversations.ts",
    "seed:dev": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-dev.ts",
    "seed:yeoyo": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-yeoyo-profiles.ts",
    "seed:yeoyo-women": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-yeoyo-women.ts",
    "smoke:auth": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/smoke-auth.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^10.52.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/otel": "^2.1.3",
    "ably": "^2.29.0",
    "arctic": "^3.7.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "heic-convert": "^2.1.0",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "otpauth": "^9.5.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.30.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/heic-convert": "^2.1.0",
    "@types/node": "^20.17.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint-config-next": "^16.2.12",
    "fast-glob": "^3.3.3",
    "postcss": "^8.5.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "vitest-mock-extended": "^3.1.1"
  }
}
